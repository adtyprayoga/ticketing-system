{
  "name": "@ticketing/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed.ts",
    "reconcile": "node --env-file-if-exists=../../.env src/reconciliation/cli.ts",
    "staff:assign": "node --env-file-if-exists=../../.env src/staff/assign-cli.ts",
    "db:reset": "node --env-file-if-exists=../../.env src/db/reset-cli.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
