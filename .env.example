# Ports (change locally if something else already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
TEST_DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Where the API is reached from the Next.js rewrite, and where the browser loads the web app
# (optional: set WEB_ORIGIN to https://<tunnel> only while you browse through a tunnel)
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# simulator | midtrans
PAYMENT_PROVIDER=simulator
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
